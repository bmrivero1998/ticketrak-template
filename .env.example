# ============================================================
# TICKETRAK — Variables de Entorno
# Copia este archivo como .env y edita los valores.
# NUNCA subas .env a git.
# ============================================================

# URL de la API de Ticketrak (sin trailing slash)
VITE_API_URL=https://api.ticketrak.com

# UUID del proyecto (obtenido desde el dashboard de MetriTrak)
VITE_PROJECT_ID=tu-project-uuid-aqui

# Nombre de la marca (aparece en el header y título)
VITE_BRAND_NAME=Ticketrak

# Tagline del hero
VITE_BRAND_TAGLINE=Vive la experiencia.

# URL pública del logo (opcional — si está vacío usa el nombre en texto)
VITE_LOGO_URL=

# URL base del sitio (para construir success_url y cancel_url de Stripe)
VITE_SITE_URL=http://localhost:5173

# Clave pública (publishable) de Stripe — NUNCA la clave secreta (sk_...)
VITE_STRIPE_PUBLIC_KEY=pk_test_tu_clave_publica_aqui

# ID de cuenta conectada de Stripe (Stripe Connect)
VITE_STRIPE_ACCOUNT=acct_tu_cuenta_aqui
